#!/usr/bin/env node
import { existsSync } from "node:fs";
import { dirname, join } from "node:path";
import { fileURLToPath, pathToFileURL } from "node:url";

const root = join(dirname(fileURLToPath(import.meta.url)), "..");
const entry = join(root, "dist", "kea", "cli.js");

if (!existsSync(entry)) {
  console.error("Kea is not built. Run npm install && npm run build in the repository.");
  process.exit(1);
}

try {
  const { runKeaCli } = await import(pathToFileURL(entry).href);
  process.exitCode = await runKeaCli(process.argv.slice(2));
} catch (error) {
  console.error(`Kea failed: ${error instanceof Error ? error.message : String(error)}`);
  process.exitCode = 1;
}
