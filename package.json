{
  "name": "waggle-kea",
  "version": "0.2.0",
  "description": "Inspectable machine coordination with a deterministic protocol, fail-closed audit layer, and reproducible ML evaluation.",
  "type": "module",
  "license": "MIT",
  "author": "William Keenan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/willykeenan/waggle-kea.git"
  },
  "homepage": "https://github.com/willykeenan/waggle-kea#readme",
  "bugs": {
    "url": "https://github.com/willykeenan/waggle-kea/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kea": {
      "types": "./dist/kea/index.d.ts",
      "import": "./dist/kea/index.js"
    },
    "./waggle": {
      "types": "./dist/waggle/index.d.ts",
      "import": "./dist/waggle/index.js"
    }
  },
  "bin": {
    "kea": "./bin/kea"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=75 tests/*.test.ts",
    "verify:benchmark": "node scripts/verify-banking77-benchmark.mjs",
    "verify:research": "node research/verify.mjs",
    "audit:dependencies": "npm audit --audit-level=high",
    "benchmark:banking77": "node scripts/run-banking77.mjs",
    "smoke:package": "node scripts/package-smoke.mjs",
    "check": "npm run typecheck && npm run test:coverage && npm run build && node dist/kea/cli.js evaluate && npm run verify:benchmark && npm run verify:research && npm run audit:dependencies && npm run smoke:package",
    "reproduce": "npm run check",
    "demo": "tsx examples/demo.ts",
    "kea": "tsx src/kea/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
